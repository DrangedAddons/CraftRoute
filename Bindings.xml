<Bindings>
  <!-- Opens the profession window on CraftRoute's tab (Keybind.lua). Change it under Options >
       Keybindings > AddOns > CraftRoute. -->
  <Binding name="CRAFTROUTE_PROFESSION_TAB" header="CRAFTROUTE" category="ADDONS" default="SHIFT-K" runOnUp="false">
    CraftRoute_KeybindPressed()
  </Binding>
  <!-- Opens / closes the Materials window (all your guides' materials). No default key. -->
  <Binding name="CRAFTROUTE_MATERIALS" header="CRAFTROUTE" category="ADDONS" runOnUp="false">
    CraftRoute_MaterialsKeyPressed()
  </Binding>
</Bindings>
